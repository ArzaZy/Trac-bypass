# --- TRAC BYPASS environment variables (server-side only) ---
# NEVER prefix any of these with NEXT_PUBLIC_.

# Authentication mode. Exactly one of:
#   admin -> the server uses BACON_API_KEY for every request.
#            Use ONLY if Bacon API's terms allow one key to serve other users.
#   user  -> each visitor enters their own key. It travels in the HTTPS POST body,
#            is used for that single request and is never stored by this app.
# Empty or any other value -> the integration is treated as "not configured".
TRAC_AUTH_MODE=

# Required only when TRAC_AUTH_MODE=admin. Leave empty otherwise.
BACON_API_KEY=

# Optional. Comma-separated origins allowed to call /api/bypass,
# e.g. https://your-domain.com,https://your-project.vercel.app
# Empty = no Origin allow-list check.
TRAC_ALLOWED_ORIGINS=

# Optional. Backend timeout for the upstream call in milliseconds (default 55000, max 58000).
# Must stay below the function limit set by `maxDuration` in src/app/api/bypass/route.ts.
TRAC_TIMEOUT_MS=
